{
  "name": "cat",
  "title": "Cat",
  "concept": "A sitting cat from three circles in golden ratio. The haunch rests on the ground line, one even channel marks the thigh, and the tail rises behind in tangent arcs.",
  "vars": {
    "ground": 84,
    "R1": 18,                   // haunch
    "R2": "R1/phi",             // chest and head (11.1)
    "R3": "R2/phi",             // front leg width / tail curl (6.9)
    "g": 1.8                    // the one channel width
  },
  "points": {
    "H": [57, "ground - R1"],   // haunch sits on the ground line
    "C": [42, 49],
    "K": [38, 31]
  },
  "shapes": {
    "haunch": {"circle": ["H", "R1"]},
    "torso":  {"hull": [{"circle": ["C", "R2"]}, "haunch"]},
    "head":   {"circle": ["K", "R2"]},
    "ears": {"union": [
      {"poly": [[28, 28], [29.5, 13], [39, 21]], "round": 0.8},
      {"poly": [[38, 21], [47.5, 14], [48.5, 28]], "round": 0.8}
    ]},
    "leg":  {"stroke": {"pts": [["C.x - 4", "C.y"], ["C.x - 4", "ground"]], "w": "R3*1.3", "cap": "butt"}},
    "tail": {"turtle": {"start": [70, 80], "heading": -15, "w": [6, 4.2],
              "steps": [{"arc": 11, "turn": -75}, {"fd": 12}, {"arc": "R3*0.8", "turn": -170}]}},
    "eye":  {"lune": {"a": [31.5, 31], "b": [37.5, 31], "bulge": [1.6, -1.6]}},
    "floor": {"rect": {"x": -20, "y": "ground", "w": 140, "h": 30}, "guide": "lines"}
  },
  "ink": [
    "torso",
    "head",
    "ears",
    "leg",
    {"add": "haunch", "gap": "g"},
    {"add": "tail", "gap": "g"},
    {"cut": "floor"},
    {"cut": "eye"}
  ]
}
